{
    "request": {
        "enabled": true,
        "algorithm": "aimd",
        "useWindowed": true,
        "aimd": {
            "initialLimit": 1000,
            "minLimit": 500,
            "maxLimit": 1500,
            "backoffRatio": 0.9,
            "requestTimeout": 0.5
        }
    },
    "write": {
        "rampUp": 0,
        "enabled": true,
        "limit": 2000,
        "throttling": {
            "enabled": true,
            "acceptableBacklog": 10000,
            "minimumLimit": 1000,
            "resolution": 5
        }
    }
}
